# Application
NODE_ENV=development
VITE_APP_ID=your-app-id

# Database
DATABASE_URL=mysql://user:password@localhost:3306/restart_support_ai

# OAuth
OAUTH_SERVER_URL=https://oauth.manus.im
OWNER_OPEN_ID=your-owner-openid
JWT_SECRET=your-jwt-secret-key

# ========== Azure OpenAI Configuration (Recommended for Cloudflare) ==========
# Set these to use Azure OpenAI with GPT-4o deployment
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ========== Legacy: Manus Forge Configuration (Fallback) ==========
# Only set these if not using Azure OpenAI
# BUILT_IN_FORGE_API_KEY=your-forge-api-key
# BUILT_IN_FORGE_API_URL=https://forge.manus.im
